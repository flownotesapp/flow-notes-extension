# Each of these lives in its own repository. Cloning one inside this tree
# nests a git repo inside another, and a `git rm -r` here would delete its
# working files -- which already happened once to docs/.
flow-notes-backend/
docs/
flownotesapp.github.io/

# Build artifacts — these were being committed before, which is why the
# helper repo carried an 8MB binary and a 17MB release zip.
flow-notes-local/dist/
flow-notes-local/flow-notes-local
*.exe
*.zip

# Secrets. Everything the backend needs comes from the environment;
# nothing secret belongs in this repository.
.env
.env.*
!.env.example
*.pem
captures-backup.sql

# macOS / editors
.DS_Store
.vscode/
.idea/
