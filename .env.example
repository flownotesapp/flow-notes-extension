# Backend configuration. Copy to .env for local work, or set these as
# variables on your host. NEVER commit the filled-in version.

# Postgres. Use the PUBLIC url when connecting from your laptop --
# Railway's default DATABASE_URL points at *.railway.internal, which only
# resolves inside Railway's own network.
DATABASE_URL=postgres://user:password@host:5432/flow_notes?sslmode=require

# Free key from console.groq.com. OPTIONAL: users can supply their own in
# the extension's settings, which meters against their quota instead of
# this shared one. Leave it unset to require that. Without either, organize
# returns 501 and the rest of the server runs normally.
GROQ_API_KEY=
# Optional. Model access is per-account: a model in Groq's public docs may
# still be unavailable on your key, and the error will list what is.
GROQ_MODEL=llama-3.1-8b-instant

# Must match manifest.json's oauth2.client_id. Until it is set, a token
# minted for ANY Google app is accepted.
GOOGLE_OAUTH_CLIENT_ID=

# The published extension's origin, e.g. chrome-extension://abcdef...
# Unset falls back to allowing any origin, which is fine locally and not
# in a deployment.
ALLOWED_ORIGINS=

# Never set this in a deployment: it disables token verification entirely.
# AUTH_DEV_MODE=1
